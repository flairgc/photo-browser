# BACKEND
BACKEND_PORT=3001
BACKEND_PORT_DEV=3002

# local | nas (SMB)
BACKEND_DATA_SOURCE=local
# Absolute paths recommended; relative paths resolve from backend/ as before.
BACKEND_FS_ROOT=
# Optional development override; falls back to BACKEND_FS_ROOT.
BACKEND_FS_ROOT_DEV=

# Example: \\192.168.1.10\photos\Family
BACKEND_NAS_HOST=192.168.1.10
BACKEND_NAS_SHARE=photos
BACKEND_NAS_PATH=Family
BACKEND_NAS_PORT=445
BACKEND_NAS_USERNAME=
BACKEND_NAS_PASSWORD=
BACKEND_NAS_DOMAIN=

# Full scan at server startup. Previews on demand always remain enabled.
BACKEND_CACHE_WARMUP=false
# Empty = .cache_photo_browser_app inside the selected photo folder (local or NAS).
# Set an absolute LOCAL path to keep the cache on the phone, e.g.:
# BACKEND_CACHE_DIR=/storage/emulated/0/PhotoBrowserCache
# Relative cache paths resolve from the project root.
BACKEND_CACHE_DIR=

# UI / API proxy
VITE_BACKEND_API_HOST=http://localhost
VITE_ALLOWED_HOST=
